{
  "name": "gp200-tone-desk",
  "version": "1.2.6",
  "private": true,
  "type": "module",
  "description": "SnapTone library and song tone planner for the Valeton GP-200. Runs entirely in the browser.",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "audit:effects": "python scripts/audit-effects.py",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
